### 2. Electron Main Process (`Desktop/main.js`)

Le fichier principal Electron gère le cycle de vie de l'application et le démarrage du backend FastAPI embarqué :

```javascript
const { app, BrowserWindow, ipcMain } = require('electron')
const { spawn } = require('child_process')
const path = require('path')

let mainWindow
let pyProc = null

function startLocalFastAPI() {
  const backendPath = app.isPackaged
    ? path.join(process.resourcesPath, 'backend', 'tia-backend.exe')
    : path.join(__dirname, '..', 'Web', 'backend', 'app', 'main.py')

  if (app.isPackaged) {
    pyProc = spawn(backendPath, ['--port', '8000', '--sqlite'])
  } else {
    pyProc = spawn('python', ['-m', 'uvicorn', 'app.main:app', '--port', '8000'], {
      cwd: path.join(__dirname, '..', 'Web', 'backend')
    })
  }

  pyProc.stdout.on('data', (data) => console.log(`FastAPI: ${data}`))
  pyProc.stderr.on('data', (data) => console.error(`FastAPI Error: ${data}`))
}

function createWindow() {
  mainWindow = new BrowserWindow({
    width: 1366,
    height: 768,
    minWidth: 1024,
    minHeight: 600,
    title: 'TIA INFO BUILD — Desktop Offline',
    webPreferences: {
      preload: path.join(__dirname, 'preload.js'),
      nodeIntegration: false,
      contextIsolation: true,
    }
  })

  // Charger le frontend Vite (dist local ou dev server)
  if (!app.isPackaged) {
    mainWindow.loadURL('http://localhost:5173')
  } else {
    mainWindow.loadFile(path.join(__dirname, '..', 'Web', 'frontend', 'dist', 'index.html'))
  }
}

app.on('ready', () => {
  startLocalFastAPI()
  createWindow()
})

app.on('will-quit', () => {
  if (pyProc) pyProc.kill()
})
```

