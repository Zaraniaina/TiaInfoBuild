# =============================================================================
# TIA INFO BUILD - Backend Environment Configuration
# =============================================================================

# --- Application ---
APP_ENV=development
APP_DEBUG=True
APP_HOST=0.0.0.0
APP_PORT=8000

# --- Database (MySQL) ---
DATABASE_URL=mysql+aiomysql://tia_user:tia_password@localhost:3306/tia_build_db

# --- Redis (rate limiting, cache) ---
REDIS_URL=redis://localhost:6379/0

# --- JWT Security ---
SECRET_KEY=CHANGE_ME_GENERATE_WITH_python_-c_"import_secrets;_print(secrets.token_urlsafe(32))"
SECRET_KEY_REFRESH=CHANGE_ME_DIFFERENT_FROM_ACCESS_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password Policy ---
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=True
PASSWORD_REQUIRE_LOWERCASE=True
PASSWORD_REQUIRE_DIGIT=True
PASSWORD_REQUIRE_SPECIAL=True

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
CORS_CREDENTIALS=True

# --- Pagination ---
DEFAULT_PAGE_SIZE=25
MAX_PAGE_SIZE=100

# --- Multi-Tenant ---
DEFAULT_ENTREPRISE_DEVISE=MGA
DEFAULT_ENTREPRISE_TVA=20.00
DEFAULT_ENTREPRISE_DELAIS_PAIEMENT=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Frontend Static ---
FRONTEND_BUILD_DIR=../frontend/dist
